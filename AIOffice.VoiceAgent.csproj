<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <Configurations>Debug;Release;Test</Configurations>
    <AssemblyName>AIOffice.VoiceAgent</AssemblyName>
    <Description>Cross-platform voice agent executable (whisper.net STT + Kokoro TTS). Primary recognition on Linux/macOS, fallback on Windows.</Description>
  </PropertyGroup>

  <!-- NuGet packaging + release gate (Graphene-Lab convention, same scheme as AgentBridge):
       IsPrerelease=true while iterating → the version gets "-prerelease". Set IsPrerelease=false
       only when the test cycles proved the version works → a real release. Date-based auto
       version 1.yy.MM.dd (e.g. 1.26.09.03). Publishing is an explicit act: pushing a tag v*
       triggers .github/workflows/publish.yml (a plain push is a code-only sync). -->
  <PropertyGroup>
    <IsPrerelease>true</IsPrerelease>
    <Version Condition="'$(IsPrerelease)' == 'true'">$([System.DateTime]::Now.ToString("1.yy.MM.dd"))-prerelease</Version>
    <Version Condition="'$(IsPrerelease)' != 'true'">$([System.DateTime]::Now.ToString("1.yy.MM.dd"))</Version>
    <PackageId>Graphene.AIOffice.VoiceAgent</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Andrea Bruno</Copyright>
    <RepositoryUrl>https://github.com/Graphene-Lab/AIOffice.VoiceAgent</RepositoryUrl>
    <PackageTags>voice;agent;stt;tts;whisper;kokoro;llm;automation</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <!-- GPU acceleration opt-in: -p:WhisperGpu=true bundles the whisper.cpp CUDA12 + Vulkan
         native runtimes (Vulkan is Windows-x64 only; on Linux the only GPU backend is CUDA).
         The whisper.net loader probes them and FALLS BACK TO CPU automatically when no usable
         GPU/driver is present, so a GPU-enabled build still works on every OS as distributed
         (the CPU runtime is always bundled — GPU is an acceleration, never a prerequisite;
         no CUDA toolkit install is needed, the packages carry their own libs). Default OFF:
         the CPU-only package stays small and has zero GPU probe overhead. The runtime backend
         can also be forced per process via AIOFFICE_WHISPER_DEVICE=auto|cuda|vulkan|cpu. -->
    <WhisperGpu Condition="'$(WhisperGpu)' == ''">false</WhisperGpu>
  </PropertyGroup>

  <ItemGroup>
    <!-- whisper.net: CPU runtime ships native libs for all supported RIDs (Win/Linux/macOS/Android/iOS).
         The ggml model is NOT bundled: it is downloaded automatically on first use.
         GPU runtimes (CUDA12/Vulkan) are OFF by default: on Turing-class GPUs (sm_75, e.g. GTX 16xx)
         the CUDA builds fail to load and the loader falls back to CPU WITH ~1.4s probe overhead per
         model load. On Ampere+ (RTX 30xx/40xx) enable them with -p:WhisperGpu=true. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Cuda12" Version="1.9.1" Condition="'$(WhisperGpu)' == 'true'" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" Condition="'$(WhisperGpu)' == 'true'" />
    <!-- KokoroSharp.CPU: neural TTS with managed phonemization (no native espeak needed).
         Model (~320 MB) is downloaded automatically by KokoroTTS.LoadModel* on first use; voices ship in the package. -->
    <PackageReference Include="KokoroSharp.CPU" Version="0.8.4" />
    <!-- NAudio: microphone capture on Windows only (Linux uses the arecord subprocess). -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- System.Speech: Windows SAPI synthesizer — TTS fallback when Kokoro is unavailable or the
         language is unsupported (architectural priority OS→NuGet). Windows TFM only. -->
    <PackageReference Include="System.Speech" Version="9.0.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <!-- KokoroSharp's buildTransitive target copies the voices to $(OutputPath) but the publish
       pipeline does not carry them to $(PublishDir). Reproduce that copy after Publish so a
       standalone published agent can load voices (KokoroVoiceManager.GetVoice requires them). -->
  <Target Name="CopyKokoroVoicesToPublish" AfterTargets="Publish"
          Condition="'$(PublishDir)' != '' and Exists('$(OutputPath)voices\')">
    <ItemGroup>
      <_KokoroVoices Include="$(OutputPath)voices\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_KokoroVoices)"
          DestinationFiles="@(_KokoroVoices->'$(PublishDir)voices\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- Provide kokoro.onnx in the output directory (the 325 MB model binary is not tracked in git).
       This is the single home of the Kokoro model asset: AIOffice.VoiceAgent.Win no longer
       downloads its own copy and reuses this one (deployed at the app base dir by the build).
       Skipped while packing (_IsPacking=true is set by the dotnet CLI): the model is NOT part of
       the NuGet package, so CI publication (publish.yml) must not download it. -->
  <Target Name="DownloadKokoroModel" BeforeTargets="Build;Publish"
          Condition="'$(_IsPacking)' != 'true' and !Exists('$(OutputPath)kokoro.onnx')">
    <MakeDir Directories="$(OutputPath)" />
    <Copy Condition="Exists('kokoro.onnx')"
          SourceFiles="kokoro.onnx"
          DestinationFiles="$(OutputPath)kokoro.onnx" />
    <Exec Condition="!Exists('$(OutputPath)kokoro.onnx')"
          Command="curl.exe -L --fail -o &quot;$(OutputPath)kokoro.onnx&quot; &quot;https://github.com/Lyrcaxis/KokoroSharpBinaries/releases/download/v2.0.0/kokoro.onnx&quot;" />
    <Message Text="kokoro.onnx ready at $(OutputPath)" Importance="high" />
  </Target>

  <!-- The README is referenced by PackageReadmeFile above and must travel inside the nupkg.
       Explicit Include (not None Update): the default-items pass yields an empty @(None) in the
       multi-TFM pack evaluation, so an Update would never match and pack fails with NU5039. -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Date-based auto version + NuGet publishing, same mechanism as the other Graphene repos
       (DocumentTool/AIOrchestrator). Local/VS: `dotnet pack` publishes with the NuGetApiKey env
       var; CI: .github/workflows/publish.yml pushes the package (pack runs with SkipNuGetPush). -->
  <Target Name="SetPackageVersion" DependsOnTargets="Build">
    <PropertyGroup>
      <PackageVersion>$(Version)</PackageVersion>
    </PropertyGroup>
  </Target>

  <PropertyGroup>
    <NuGetSource Condition="'$(NuGetSource)' == ''">https://api.nuget.org/v3/index.json</NuGetSource>
  </PropertyGroup>

  <Target Name="CleanOldNuGetPackages" BeforeTargets="GenerateNuspec">
    <CreateItem Include="$(PackageOutputPath)*.nupkg">
      <Output TaskParameter="Include" ItemName="_OldNupkg" />
    </CreateItem>
    <Delete Files="@(_OldNupkg)" />
  </Target>

  <Target Name="PublishPackageToNuGet" AfterTargets="Pack" Condition="'$(SkipNuGetPush)' != 'true'">
    <Error Condition="'$(NuGetApiKey)' == ''"
           Text="NuGetApiKey env var not set: run `setx NuGetApiKey &lt;key&gt;` and restart Visual Studio." />
    <CreateItem Include="$(PackageOutputPath)*.nupkg">
      <Output TaskParameter="Include" ItemName="_NuGetPackageToPush" />
    </CreateItem>
    <Error Condition="'@(_NuGetPackageToPush)' == ''"
           Text="No package found in $(PackageOutputPath): pack produced no expected file." />
    <Message Importance="High" Text="Publishing %(_NuGetPackageToPush.Identity) to $(NuGetSource) ..." />
    <Exec Command="dotnet nuget push &quot;%(_NuGetPackageToPush.Identity)&quot; --api-key &quot;$(NuGetApiKey)&quot; --source &quot;$(NuGetSource)&quot; --skip-duplicate" />
  </Target>

</Project>
